{
  "name": "@grafctory/gate",
  "description": "Zero-code model-driven endpoints for linked data resources.",
  "version": "0.15.1",
  "keywords": [
    "typescript",
    "json-ld",
    "model-driven",
    "rest-json",
    "express"
  ],
  "homepage": "https://grafctory.github.io/gate/",
  "bugs": {
    "url": "https://github.com/grafctory/gate/issues",
    "email": "info@grafctory.dev"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grafctory/gate.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@grafctory/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "@grafctory/source": "./src/handlers/client.ts",
      "default": "./dist/handlers/client.js"
    },
    "./driver": {
      "@grafctory/source": "./src/routers/driver/index.ts",
      "default": "./dist/routers/driver/index.js"
    },
    "./worker": {
      "@grafctory/source": "./src/handlers/worker.ts",
      "default": "./dist/handlers/worker.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "ush rm dist docs node_modules",
    "prime": "npm ci",
    "setup": "npm ci && ush ln",
    "build": "ush rm dist docs && tsc -p tsconfig.build.json && npx typedoc",
    "check": "npx vitest --typecheck run",
    "proof": "ush up npx typedoc --watch + ush ws --open docs"
  },
  "dependencies": {
    "@grafctory/blue": "^0.16.0",
    "@grafctory/core": "^0.14.0",
    "@grafctory/http": "^0.6.0",
    "@grafctory/keep": "^0.15.0",
    "@grafctory/qest": "^0.15.0",
    "@grafctory/tape": "^0.13.0"
  },
  "devDependencies": {
    "@grafctory/rack": "^0.8.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "express": "^5.3.0",
    "typedoc": "^0.28.14",
    "typescript": "^6.0.3",
    "vitest": "^4.0.13"
  },
  "peerDependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.3.0"
  },
  "peerDependenciesMeta": {
    "@types/express": {
      "optional": true
    }
  }
}
